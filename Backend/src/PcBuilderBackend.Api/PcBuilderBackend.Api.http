###############################################################################
# Catalog - Motherboard
# Routes: /api/catalog/motherboard
# Enums: DdrGeneration (Ddr4=4, Ddr5=5)
#        RamFormFactor (UDimm=1, SoDimm=2)
#        MbFormFactor (Mitx=1, Matx=2, Atx=3, Eatx=4)
#        PcieGeneration (Gen3=3, Gen4=4, Gen5=5, Gen6=6)
#        PcieSlotType / PcieSlotLane (X1=1, X4=4, X8=8, X16=16)
#        M2FormFactor (M22230=1, M22242=2, M22260=3, M22280=4, M222110=5)
#        M2Key (M=1, B=2, E=3, BM=4; slots use M/B/E only)
#        UsbVersion (Usb20=1, Usb32Gen1=2, Usb32Gen2=3, Usb4=4)
#        UsbType (TypeA=1, TypeC=2)
###############################################################################

### Get Motherboards (filters)
GET {{PcBuilderBackend.Api_HostAddress}}/api/catalog/motherboard?name=&manufacturerId={{manufacturerId}}&socketId={{socketId}}&chipsetId={{chipsetId}}&ddrGeneration=5&ramFormFactor=1&formFactor=3&wifiEnabled=true&bluetoothEnabled=true
Accept: application/json

###

### Get Motherboard by Id
GET {{PcBuilderBackend.Api_HostAddress}}/api/catalog/motherboard/{{motherboardId}}
Accept: application/json

###

### Create Motherboard
POST {{PcBuilderBackend.Api_HostAddress}}/api/catalog/motherboard
Content-Type: {{ContentType}}
Accept: application/json

{
  "name": "ROG STRIX X670E-E GAMING WIFI",
  "manufacturerId": "{{manufacturerId}}",
  "socketId": "{{socketId}}",
  "chipsetId": "{{chipsetId}}",
  "ramSlots": 4,
  "maxMemoryGb": 192,
  "maxDimmSizeGb": 48,
  "sataPorts": 6,
  "fanConnectors": 7,
  "epsConnectors": 2,
  "widthMm": 305.0,
  "heightMm": 244.0,
  "ddrGeneration": 5,
  "ramFormFactor": 1,
  "formFactor": 3,
  "wifiEnabled": true,
  "bluetoothEnabled": true,
  "pcieSlots": [
    {
      "slotType": 16,
      "slotLanes": 16,
      "generation": 5,
      "slotCount": 1
    },
    {
      "slotType": 16,
      "slotLanes": 4,
      "generation": 4,
      "slotCount": 1
    }
  ],
  "m2Slots": [
    {
      "key": 1,
      "pcieGeneration": 5,
      "slotCount": 1,
      "supportsSata": false,
      "formFactors": [4]
    },
    {
      "key": 1,
      "pcieGeneration": 4,
      "slotCount": 3,
      "supportsSata": true,
      "formFactors": [4, 5]
    },
    {
      "key": 3,
      "pcieGeneration": 4,
      "slotCount": 1,
      "supportsSata": false,
      "formFactors": [1]
    }
  ],
  "usbPorts": [
    {
      "usbVersion": 2,
      "usbType": 1,
      "portCount": 4
    },
    {
      "usbVersion": 4,
      "usbType": 2,
      "portCount": 2
    }
  ]
}

###

### Update Motherboard
PUT {{PcBuilderBackend.Api_HostAddress}}/api/catalog/motherboard
Content-Type: {{ContentType}}
Accept: application/json

{
  "id": "{{motherboardId}}",
  "name": "ROG STRIX X670E-E GAMING WIFI",
  "manufacturerId": "{{manufacturerId}}",
  "socketId": "{{socketId}}",
  "chipsetId": "{{chipsetId}}",
  "ramSlots": 4,
  "maxMemoryGb": 192,
  "maxDimmSizeGb": 48,
  "sataPorts": 6,
  "fanConnectors": 7,
  "epsConnectors": 2,
  "widthMm": 305.0,
  "heightMm": 244.0,
  "ddrGeneration": 5,
