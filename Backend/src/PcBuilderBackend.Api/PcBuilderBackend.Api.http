###############################################################################
# Auth
# Routes: /api/auth
###############################################################################

### Register Member
POST {{PcBuilderBackend.Api_HostAddress}}/api/auth/register
Content-Type: {{ContentType}}
Accept: application/json

{
  "email": "member@localhost",
  "password": "ChangeMe!Member1",
  "userName": "testmember"
}

###

### Login
POST {{PcBuilderBackend.Api_HostAddress}}/api/auth/login
Content-Type: {{ContentType}}
Accept: application/json

{
  "email": "admin@localhost",
  "password": "ChangeMe!Admin1"
}

###

### Refresh
POST {{PcBuilderBackend.Api_HostAddress}}/api/auth/refresh
Content-Type: {{ContentType}}
Accept: application/json

{
  "refreshToken": ""
}

###

### Current user
GET {{PcBuilderBackend.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

### Logout
POST {{PcBuilderBackend.Api_HostAddress}}/api/auth/logout
Content-Type: {{ContentType}}
Accept: application/json

{}

###

### Forgot password
POST {{PcBuilderBackend.Api_HostAddress}}/api/auth/forgot-password
Content-Type: {{ContentType}}
Accept: application/json

{
  "email": "member@localhost"
}

###

### Reset password
POST {{PcBuilderBackend.Api_HostAddress}}/api/auth/reset-password
Content-Type: {{ContentType}}
Accept: application/json

{
  "email": "member@localhost",
  "token": "",
  "newPassword": "ChangeMe!Member2",
  "confirmNewPassword": "ChangeMe!Member2"
}

###

### Change password
POST {{PcBuilderBackend.Api_HostAddress}}/api/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: {{ContentType}}
Accept: application/json

{
  "currentPassword": "ChangeMe!Member1",
  "newPassword": "ChangeMe!Member2",
  "confirmNewPassword": "ChangeMe!Member2"
}

###

### Get Specification

GET {{PcBuilderBackend.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###############################################################################
# Master Data - Manufacturer
# Routes: /api/master-data/manufacturer
###############################################################################

### Get All Manufacturers
GET {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer
Accept: application/json

###

### Get Manufacturer by Id
GET {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/{{manufacturerId}}
Accept: application/json

###

### Create Manufacturer
POST {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer
Authorization: Bearer {{accessToken}}
Content-Type: {{ContentType}}
Accept: application/json

{
  "name": "NVIDIA"
}

###

### Update Manufacturer
PUT {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer
Content-Type: {{ContentType}}
Accept: application/json

{
  "id": "{{manufacturerId}}",
  "name": "NVIDIA"
}

###

### Delete Manufacturer
DELETE {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/{{manufacturerId}}
Accept: application/json

###

### Bulk Create Manufacturers
POST {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/bulk
Content-Type: {{ContentType}}
Accept: application/json

{
  "names": [
    "ASUS",
    "MSI",
    "Gigabyte"
  ]
}

###

### Bulk Update Manufacturers
PUT {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/bulk
Content-Type: {{ContentType}}
Accept: application/json

{
  "manufacturers": [
    {
      "id": "{{manufacturerId}}",
      "name": "ASUS"
    }
  ]
}

###

### Bulk Delete Manufacturers
# Body is a raw Guid array (not wrapped)
DELETE {{PcBuilderBackend.Api_HostAddress}}/api/master-data/manufacturer/bulk
Content-Type: {{ContentType}}
Accept: application/json

[
  "{{manufacturerId}}"
]

###

