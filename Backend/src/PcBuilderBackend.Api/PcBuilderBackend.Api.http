    "slotCount": 1,
    "supportsSata": false,
    "formFactors": [4]
  },
  {
    "key": 1,
    "pcieGeneration": 4,
    "slotCount": 3,
    "supportsSata": true,
    "formFactors": [4, 5]
  },
  {
    "key": 3,
    "pcieGeneration": 4,
