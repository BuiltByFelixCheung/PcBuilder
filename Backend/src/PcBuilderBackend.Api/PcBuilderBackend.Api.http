###############################################################################
# Catalog - Graphics Card
# Routes: /api/catalog/graphics-card
# Enums: PcieGeneration (Gen3=3, Gen4=4, Gen5=5, Gen6=6)
#        PsuCableType (Motherboard24Pin=1, Cpu4Plus4Pin=2, Pcie6Plus2Pin=3,
#                      Pcie12VHighPower=4, Pcie12V2X6=5, Sata=6, Molex=7, Floppy=8)
###############################################################################

### Get Graphics Cards (paged + filters)
GET {{PcBuilderBackend.Api_HostAddress}}/api/catalog/graphics-card?pageIndex=0&pageSize=10&name=&manufacturerId={{manufacturerId}}&gpuId={{gpuId}}&pcieGeneration=4&minVideoMemoryGb=8&maxVideoMemoryGb=24&maxLengthMm=340&maxPowerConsumptionWatts=350
Accept: application/json

###

### Get Graphics Card by Id
GET {{PcBuilderBackend.Api_HostAddress}}/api/catalog/graphics-card/{{graphicsCardId}}
Accept: application/json

###

### Create Graphics Card
POST {{PcBuilderBackend.Api_HostAddress}}/api/catalog/graphics-card
Content-Type: {{ContentType}}
Accept: application/json

{
  "name": "TUF Gaming GeForce RTX 4070",
  "manufacturerId": "{{manufacturerId}}",
  "gpuId": "{{gpuId}}",
  "videoMemoryGb": 12,
  "pcieSlotsUsed": 2,
  "pcieGeneration": 4,
  "lengthMm": 305.0,
  "widthMm": 138.0,
  "heightMm": 65.0,
  "powerConsumptionWatts": 200,
  "powerConnectorType": 3,
  "powerConnectorCount": 1
}

###

### Update Graphics Card
PUT {{PcBuilderBackend.Api_HostAddress}}/api/catalog/graphics-card
Content-Type: {{ContentType}}
Accept: application/json

{
  "id": "{{graphicsCardId}}",
  "name": "TUF Gaming GeForce RTX 4070",
  "manufacturerId": "{{manufacturerId}}",
  "gpuId": "{{gpuId}}",
  "videoMemoryGb": 12,
  "pcieSlotsUsed": 2,
  "pcieGeneration": 4,
  "lengthMm": 305.0,
  "widthMm": 138.0,
  "heightMm": 65.0,
