        {
          "ddrGeneration": 5,
          "ramModuleCount": 2,
          "ramRank": 1,
          "maxSpeedMts": 5200
        }
      ],
      "supportChipsets": [
        {
          "chipsetId": "{{chipsetId}}",
          "requiresBiosUpdate": false
        }
      ]
    }
  ]
}

###

### Bulk Update CPUs
