###

### Import GPUs from Excel
# Parameter name must be "file"
POST {{PcBuilderBackend.Api_HostAddress}}/api/master-data/gpu/import
Content-Type: multipart/form-data; boundary=----GpuImportBoundary
Accept: application/json

------GpuImportBoundary
Content-Disposition: form-data; name="file"; filename="gpus.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./gpus.xlsx
------GpuImportBoundary--

###

###############################################################################
# Catalog - CPU
# Routes: /api/catalog/cpu
# Enums: DdrGeneration (Ddr4=4, Ddr5=5), RamRank (SingleRank=1, DualRank=2)
###############################################################################

### Get CPUs (paged + filters)
GET {{PcBuilderBackend.Api_HostAddress}}/api/catalog/cpu?pageIndex=0&pageSize=10&name=&manufacturerId={{manufacturerId}}&socketId={{socketId}}&seriesId={{cpuSeriesId}}&ddrGeneration=5
Accept: application/json

###

### Get CPUs by Motherboard Id
GET {{PcBuilderBackend.Api_HostAddress}}/api/catalog/cpu/motherboard/{{motherboardId}}
Accept: application/json

###

### Get CPU by Id
GET {{PcBuilderBackend.Api_HostAddress}}/api/catalog/cpu/{{cpuId}}
Accept: application/json

###

### Create CPU
POST {{PcBuilderBackend.Api_HostAddress}}/api/catalog/cpu
Content-Type: {{ContentType}}
Accept: application/json

{
  "name": "Ryzen 7 7800X3D",
  "manufacturerId": "{{manufacturerId}}",
  "socketId": "{{socketId}}",
  "seriesId": "{{cpuSeriesId}}",
  "maxMemoryGb": 128,
  "integratedGraphics": true,
  "includedStockCooler": false,
  "thermalDesignPower": 120,
  "powerConsumptionWatts": 162,
  "ramCompats": [
    {
      "ddrGeneration": 5,
      "ramModuleCount": 2,
      "ramRank": 1,
      "maxSpeedMts": 5200
    }
  ],
  "supportChipsets": [
    {
      "chipsetId": "{{chipsetId}}",
      "requiresBiosUpdate": false
    }
  ]
}

###

### Update CPU
PUT {{PcBuilderBackend.Api_HostAddress}}/api/catalog/cpu
Content-Type: {{ContentType}}
Accept: application/json

{
  "id": "{{cpuId}}",
  "name": "Ryzen 7 7800X3D",
  "manufacturerId": "{{manufacturerId}}",
  "socketId": "{{socketId}}",
  "seriesId": "{{cpuSeriesId}}",
  "maxMemoryGb": 128,
  "integratedGraphics": true,
  "includedStockCooler": false,
  "thermalDesignPower": 120,
  "powerConsumptionWatts": 162
}

###

### Delete CPU
DELETE {{PcBuilderBackend.Api_HostAddress}}/api/catalog/cpu/{{cpuId}}
Accept: application/json

###

### Bulk Create CPUs
POST {{PcBuilderBackend.Api_HostAddress}}/api/catalog/cpu/bulk
Content-Type: {{ContentType}}
Accept: application/json

{
  "cpus": [
    {
      "id": "00000000-0000-0000-0000-000000000000",
      "name": "Ryzen 5 7600",
      "manufacturerId": "{{manufacturerId}}",
      "socketId": "{{socketId}}",
      "seriesId": "{{cpuSeriesId}}",
      "maxMemoryGb": 128,
      "integratedGraphics": true,
      "includedStockCooler": true,
